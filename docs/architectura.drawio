        <mxCell id="security-notes-label" value="NOTAS DE SEGURIDAD" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1;fontColor=#E65100;" vertex="1" parent="1">
          <mxGeometry x="60" y="1110" width="200" height="25" as="geometry" />
        </mxCell>
        
        <mxCell id="security-notes-content" value="✓ JWT con roles (Admin/User) | ✓ Rate Limiting por IP | ✓ Validación de entrada (FluentValidation) | ✓ Manejo seguro de errores | ✓ Logs sin datos sensibles | ✓ HTTPS en producción" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#BF360C;" vertex="1" parent="1">
