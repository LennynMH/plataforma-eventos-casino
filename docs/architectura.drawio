            <mxPoint x="400" y="400" as="sourcePoint" />
            <mxPoint x="450" y="350" as="targetPoint" />
            <Array as="points">
              <mxPoint x="300" y="350" />
              <mxPoint x="300" y="340" />
              <mxPoint x="250" y="340" />
            </Array>
          </mxGeometry>
        </mxCell>
        
        <!-- Flujo 2: Crear Evento -->
        <mxCell id="flow-http-create" value="2. HTTP POST /api/events&#xa;   JWT Auth (Admin)" style="endArrow=classic;html=1;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeWidth=3;strokeColor=#1976D2;fillColor=#1976D2;fontSize=11;fontColor=#FFFFFF;fontStyle=1;" edge="1" parent="1" source="frontend-box" target="event-service-box">
