        <mxCell id="authorization-box" value="Authorization Policies&#xa;• Admin Policy: POST /events&#xa;• User Policy: GET /events&#xa;• Rate Limiting: Por IP&#xa;• Validación: FluentValidation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E65100;strokeWidth=2;align=left;spacingLeft=15;fontSize=11;fontColor=#BF360C;" vertex="1" parent="1">
