            <mxPoint x="400" y="400" as="sourcePoint" />
            <mxPoint x="450" y="350" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        
        <!-- Flujo 3: Listar Eventos -->
        <mxCell id="flow-http-list" value="3. HTTP GET /api/events&#xa;   JWT Auth (User/Admin)" style="endArrow=classic;html=1;rounded=0;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;strokeWidth=3;strokeColor=#1976D2;fillColor=#1976D2;fontSize=11;fontColor=#FFFFFF;fontStyle=1;" edge="1" parent="1" source="frontend-box" target="event-service-box">
