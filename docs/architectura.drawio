        <mxCell id="flow-async-publish" value="4. EventCreated Message&#xa;   (Asíncrono)&#xa;   MassTransit Publish" style="endArrow=classic;html=1;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=3;strokeColor=#FF6F00;fillColor=#FF6F00;fontSize=11;fontColor=#FFFFFF;fontStyle=1;dashed=1;" edge="1" parent="1" source="event-service-box" target="rabbitmq-box">
