        <mxCell id="patterns-box" value="Patrones Arquitectónicos:&#xa;• Clean Architecture&#xa;• Domain-Driven Design (DDD)&#xa;• CQRS (Commands/Queries)&#xa;• Event-Driven Architecture&#xa;• Repository Pattern" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F57F17;strokeWidth=2;align=left;spacingLeft=15;fontSize=11;fontColor=#E65100;" vertex="1" parent="1">
