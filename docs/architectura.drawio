        <!-- ========== SUSTENTACIÓN ========== -->
        <mxCell id="justification-container" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#0277BD;strokeWidth=3;dashed=0;shadow=1;opacity=100;" vertex="1" parent="1">
          <mxGeometry x="680" y="1100" width="620" height="80" as="geometry" />
