          <mxGeometry x="60" y="310" width="300" height="30" as="geometry" />
        </mxCell>
        
        <!-- EventService -->
        <mxCell id="event-service-box" value="EventService API&#xa;.NET 9 | Port: 8070&#xa;Clean Architecture + DDD + CQRS&#xa;&#xa;Endpoints:&#xa;• POST /api/auth/login&#xa;• POST /api/events (Admin)&#xa;• GET /api/events (User/Admin)&#xa;• GET /api/events/{id} (User/Admin)&#xa;&#xa;Tecnologías:&#xa;• MediatR (CQRS)&#xa;• FluentValidation&#xa;• AutoMapper&#xa;• EF Core 8.0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#388E3C;strokeWidth=2;align=left;spacingLeft=15;fontSize=11;fontColor=#1B5E20;" vertex="1" parent="1">
          <mxGeometry x="60" y="350" width="380" height="210" as="geometry" />
        </mxCell>
        
        <!-- NotificationService -->
        <mxCell id="notification-service-box" value="NotificationService API&#xa;.NET 9 | Port: 8071&#xa;Clean Architecture + DDD&#xa;&#xa;Endpoints:&#xa;• GET /api/notifications&#xa;• GET /api/notifications/{id}&#xa;• GET /api/notifications/failed&#xa;• GET /api/notifications/failed/statistics&#xa;&#xa;Tecnologías:&#xa;• MassTransit (Consumer)&#xa;• Polly (Retry Policy)&#xa;• MailKit (Email)&#xa;• EF Core 8.0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#388E3C;strokeWidth=2;align=left;spacingLeft=15;fontSize=11;fontColor=#1B5E20;" vertex="1" parent="1">
          <mxGeometry x="470" y="350" width="370" height="210" as="geometry" />
        </mxCell>
        
        <!-- ========== MESSAGE BROKER ========== -->
