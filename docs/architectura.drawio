        <mxCell id="frontend-box" value="Next.js Frontend&#xa;React 18 + TypeScript + Tailwind CSS&#xa;Port: 3002&#xa;&#xa;Componentes:&#xa;• LoginForm&#xa;• EventRegistrationForm&#xa;• AuthGuard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1976D2;strokeWidth=2;align=left;spacingLeft=15;fontSize=12;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="60" y="170" width="480" height="80" as="geometry" />
        </mxCell>
        
        <!-- ========== CAPA API GATEWAY (Futuro) ========== -->
        <mxCell id="gateway-box" value="API Gateway / Load Balancer&#xa;(Futuro - Producción)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;strokeWidth=2;dashed=1;align=center;fontSize=12;fontStyle=2;fontColor=#5D4037;" vertex="1" parent="1">
