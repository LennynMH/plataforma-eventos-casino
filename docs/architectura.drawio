        <!-- ========== FLUJOS HTTP SÍNCRONOS ========== -->
        <!-- Flujo 1: Login -->
        <mxCell id="flow-http-login" value="1. HTTP POST /api/auth/login&#xa;   (Sin autenticación)" style="endArrow=classic;html=1;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;strokeWidth=3;strokeColor=#1976D2;fillColor=#1976D2;fontSize=11;fontColor=#FFFFFF;fontStyle=1;" edge="1" parent="1" source="frontend-box" target="event-service-box">
