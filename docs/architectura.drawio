          <mxGeometry x="900" y="300" width="350" height="280" as="geometry" />
        </mxCell>
        
        <mxCell id="rabbitmq-label" value="MESSAGE BROKER" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;fontColor=#C62828;" vertex="1" parent="1">
          <mxGeometry x="910" y="310" width="200" height="30" as="geometry" />
        </mxCell>
        
        <mxCell id="rabbitmq-box" value="RabbitMQ&#xa;Message Broker&#xa;&#xa;Puertos:&#xa;• 5672 (AMQP)&#xa;• 15672 (Management UI)&#xa;&#xa;Colas:&#xa;• event-created-queue (Principal)&#xa;• event-created-dlq (Dead Letter)&#xa;&#xa;Configuración:&#xa;• Reintentos: 3 intentos&#xa;• Exponential Backoff&#xa;• DLQ explícito&#xa;• TTL en DLQ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C62828;strokeWidth=2;align=left;spacingLeft=15;fontSize=11;fontColor=#B71C1C;" vertex="1" parent="1">
          <mxGeometry x="910" y="350" width="330" height="210" as="geometry" />
        </mxCell>
        
        <!-- ========== PERSISTENCE LAYER ========== -->
        <mxCell id="persistence-container" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#7B1FA2;strokeWidth=3;dashed=0;shadow=1;opacity=100;" vertex="1" parent="1">
          <mxGeometry x="50" y="620" width="1200" height="280" as="geometry" />
        </mxCell>
        
        <mxCell id="persistence-label" value="PERSISTENCE LAYER" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;fontColor=#7B1FA2;" vertex="1" parent="1">
          <mxGeometry x="60" y="630" width="250" height="30" as="geometry" />
        </mxCell>
        
        <!-- PostgreSQL Events -->
        <mxCell id="postgres-events-box" value="PostgreSQL (EventService)&#xa;Port: 5432 | Database: eventdb&#xa;&#xa;Schema: events&#xa;• Events (id, name, date, location, status)&#xa;• Zones (id, eventId, name, price, capacity)&#xa;• __EFMigrationsHistory&#xa;&#xa;ORM: Entity Framework Core 8.0&#xa;Migrations: Automáticas en startup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7B1FA2;strokeWidth=2;align=left;spacingLeft=15;fontSize=11;fontColor=#4A148C;" vertex="1" parent="1">
          <mxGeometry x="60" y="680" width="380" height="200" as="geometry" />
        </mxCell>
        
        <!-- PostgreSQL Notifications -->
        <mxCell id="postgres-notifications-box" value="PostgreSQL (NotificationService)&#xa;Port: 5433 | Database: notificationdb&#xa;&#xa;Schema: notifications&#xa;• NotificationLogs (eventId, eventName, status, payloadHash)&#xa;• ProcessedMessages (messageId, status) - Idempotencia&#xa;• __EFMigrationsHistory&#xa;&#xa;ORM: Entity Framework Core 8.0&#xa;Migrations: Automáticas en startup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7B1FA2;strokeWidth=2;align=left;spacingLeft=15;fontSize=11;fontColor=#4A148C;" vertex="1" parent="1">
          <mxGeometry x="470" y="680" width="380" height="200" as="geometry" />
        </mxCell>
        
        <!-- Redis Cache -->
        <mxCell id="redis-box" value="Redis Cache&#xa;Port: 6379&#xa;&#xa;Uso: Cache de listados de eventos&#xa;TTL: 5 minutos&#xa;Keys: events:list:*&#xa;&#xa;Operaciones:&#xa;• GetAsync (lectura)&#xa;• SetAsync (escritura)&#xa;• RemoveByPatternAsync (invalidación)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7B1FA2;strokeWidth=2;align=left;spacingLeft=15;fontSize=11;fontColor=#4A148C;" vertex="1" parent="1">
          <mxGeometry x="880" y="680" width="360" height="200" as="geometry" />
        </mxCell>
        
