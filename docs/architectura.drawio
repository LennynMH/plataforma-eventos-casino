        <mxCell id="justification-label" value="SUSTENTACIÓN ARQUITECTÓNICA" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1;fontColor=#0277BD;" vertex="1" parent="1">
          <mxGeometry x="690" y="1110" width="300" height="25" as="geometry" />
        </mxCell>
        
        <mxCell id="justification-content" value="La arquitectura implementada sigue principios de microservicios y event-driven, permitiendo escalabilidad horizontal, desacoplamiento entre servicios y alta disponibilidad. El uso de Clean Architecture y DDD garantiza mantenibilidad y testabilidad. La comunicación asíncrona mediante RabbitMQ permite procesamiento en background y resiliencia ante fallos. PostgreSQL por servicio asegura independencia de datos, mientras que Redis optimiza el rendimiento con cache distribuido." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#01579B;" vertex="1" parent="1">
          <mxGeometry x="690" y="1140" width="600" height="30" as="geometry" />
        </mxCell>
        
