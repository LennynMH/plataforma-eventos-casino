        <mxCell id="libraries-box" value="Librerías .NET:&#xa;• Entity Framework Core 8.0&#xa;• MassTransit (RabbitMQ)&#xa;• MediatR (CQRS)&#xa;• AutoMapper&#xa;• FluentValidation&#xa;• Polly (Retry Policy)&#xa;• MailKit (Email)&#xa;• StackExchange.Redis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F57F17;strokeWidth=2;align=left;spacingLeft=15;fontSize=11;fontColor=#E65100;" vertex="1" parent="1">
          <mxGeometry x="1310" y="730" width="330" height="140" as="geometry" />
        </mxCell>
        
        <mxCell id="resilience-box" value="Patrones de Resiliencia:&#xa;• Retry Policy (Exponential Backoff)&#xa;• Dead Letter Queue (DLQ)&#xa;• Idempotencia (ProcessedMessages)&#xa;• Health Checks (/health)&#xa;• Circuit Breaker (Futuro)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F57F17;strokeWidth=2;align=left;spacingLeft=15;fontSize=11;fontColor=#E65100;" vertex="1" parent="1">
          <mxGeometry x="1310" y="880" width="330" height="100" as="geometry" />
        </mxCell>
        
        <mxCell id="observability-box" value="Observabilidad:&#xa;• Structured Logging (ILogger)&#xa;• Correlation IDs&#xa;• Payload Hash (Auditoría)&#xa;• Health Endpoints&#xa;• Swagger/OpenAPI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F57F17;strokeWidth=2;align=left;spacingLeft=15;fontSize=11;fontColor=#E65100;" vertex="1" parent="1">
          <mxGeometry x="1310" y="990" width="330" height="100" as="geometry" />
        </mxCell>
        
        <!-- ========== NOTAS DE SEGURIDAD ========== -->
        <mxCell id="security-notes-container" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=3;dashed=0;shadow=1;opacity=100;" vertex="1" parent="1">
